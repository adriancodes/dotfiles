# Required tools for this configuration:
# brew install \
#   eza \
#   bat \
#   fd \
#   ripgrep \
#   fzf \
#   zoxide
#
# Optional but recommended tools:
# brew install \
#   dust \
#   duf \
#   procs \
#   btop \
#   direnv 

# Performance profiling (uncomment to debug slow startup)
# zmodload zsh/zprof

# Locale — guarantee UTF-8 even when the parent didn't set one (notably
# `su - neo`, where macOS drops LANG). A non-UTF-8 locale makes multibyte prompt
# glyphs miscount, so backspace appears to insert spaces and zinit's color codes
# render as literal {nl}{info} tokens. The :- guards leave an existing locale as-is.
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-$LANG}"

# Terminal capabilities (terminfo). Some terminals — notably Ghostty — ship their
# own terminfo (xterm-ghostty) inside the app bundle and point to it via $TERMINFO,
# which `su -` strips. That leaves $TERM unresolvable in another account (e.g. neo)
# and breaks line editing. Layer 1: re-add known app-bundle terminfo dirs so the
# real entry still resolves (trailing colon keeps the system database).
for _tinfo in /Applications/Ghostty.app/Contents/Resources/terminfo; do
    [[ -d $_tinfo ]] && export TERMINFO_DIRS="$_tinfo:${TERMINFO_DIRS}"
done
unset _tinfo
# Layer 2: if $TERM still can't be resolved, fall back to a universally-available
# entry so typing works no matter the terminal.
if ! infocmp "$TERM" >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Keep PATH free of duplicates no matter how many times it's appended below
typeset -U path PATH

# ZINIT
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Load plugins
# Note: zsh-syntax-highlighting must be loaded last.
# Completion is initialized once at the end via zinit's zicompinit (after every
# completion source is loaded), so there's no manual compinit here. blockf stops
# zsh-completions from calling compdef before that single init runs.
zinit ice lucid wait='0' blockf
zinit light zsh-users/zsh-completions

zinit ice lucid wait='0'
zinit light Aloxaf/fzf-tab

zinit ice lucid wait='0' atload='_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

# Load Oh-My-Zsh snippets
zinit snippet OMZL::git.zsh
zinit snippet OMZP::git
zinit snippet OMZP::aws
zinit snippet OMZP::command-not-found

# Must be loaded last
# compinit -i: silently skip "insecure" completion dirs instead of prompting.
# On a shared Mac, Homebrew's completion dirs are owned by the brew-owning user
# (adrian), which zsh flags for any OTHER account (neo). -i drops just those and
# keeps each account's own secure completions. No-op for the brew owner.
zinit ice lucid wait='0' atinit='autoload -Uz compinit; compinit -i; zicdreplay'
zinit light zdharma-continuum/fast-syntax-highlighting

# Enhanced keybindings
bindkey -e  # Emacs keybindings
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region
bindkey '^[[A' up-line-or-search      # Up arrow
bindkey '^[[B' down-line-or-search    # Down arrow
bindkey '^[[1;5C' forward-word        # Ctrl+right
bindkey '^[[1;5D' backward-word       # Ctrl+left

# History configuration
HISTSIZE=1000000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt HIST_IGNORE_ALL_DUPS    # Remove older duplicate entries from history
setopt HIST_REDUCE_BLANKS      # Remove superfluous blanks from history items
setopt HIST_VERIFY             # Show command with history expansion to user before running it
setopt SHARE_HISTORY          # Share history between all sessions
setopt EXTENDED_HISTORY       # Record timestamp of command in HISTFILE
setopt HIST_EXPIRE_DUPS_FIRST # Delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt HIST_IGNORE_SPACE      # Ignore commands that start with space

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case insensitive completion
zstyle ':completion:*' menu select                         # Menu-style completion
zstyle ':completion:*' special-dirs true                   # Complete . and .. special directories
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}     # Colored completion (different colors for dirs/files/etc)
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*:approximate:*' max-errors 2

# FZF tab completion styling
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --tree --level=1 --color=always $realpath || ls -l --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza --tree --level=1 --color=always $realpath || ls -l --color=always $realpath'

# Better directory navigation
setopt AUTO_CD              # Go to folder path without using cd
setopt AUTO_PUSHD          # Push the old directory onto the stack on cd
setopt PUSHD_IGNORE_DUPS   # Do not store duplicates in the stack
setopt PUSHD_SILENT        # Do not print the directory stack after pushd or popd

# Enhanced aliases
# Modern replacements for common tools
if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first --icons'
    alias ll='eza -l --group-directories-first --icons'
    alias la='eza -la --group-directories-first --icons'
    alias lt='eza --tree --level=2 --group-directories-first --icons'
fi

if (( $+commands[bat] )); then
    alias cat='bat'
fi

# Note: fd and rg are NOT flag-compatible with find/grep, so they're left under
# their own names rather than shadowing the classics (avoids breaking pasted
# `find -name` / `grep -oP` style commands). Use `fd` and `rg` directly.

# Conditional aliases based on OS
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS specific aliases
    alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
    alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
    alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"
fi

# Shell

alias reloadz='exec zsh'

# Directory and file operations
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mkdir='mkdir -pv'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'
alias cr='cursor'
alias em='emacs -nw'
alias editrc='emacs -nw ~/.zshrc'

# Git aliases
alias g='git'
alias gs='git status'
alias gp='git push'
alias gpl='git pull'
alias gc='git commit'
alias gco='git checkout'
alias gb='git branch'
alias gl='git log --oneline --graph --decorate'

# Utility aliases
alias aliases='alias | sort'         # List all aliases
alias paths='echo -e ${PATH//:/\n}'  # Print each PATH entry on its own line

# Development
# alias npm-update='npx npm-check-updates -u && npm install'
# alias yarn-update='yarn upgrade-interactive --latest'
# alias docker-clean='docker system prune -af'

# Emacs
alias doomsync='~/.emacs.d/bin/doom sync'

# FZF configuration
if (( $+commands[fzf] )); then
    export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
    if (( $+commands[bat] )); then
        export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --preview 'bat --style=numbers --color=always {}'"
    fi
    if (( $+commands[fd] )); then
        export FZF_DEFAULT_COMMAND='fd --type file --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type directory --hidden --follow --exclude .git'
    fi
fi

# Homebrew
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Node/Python/Go versions are managed by mise (activated at the very end of this
# file so its shims take precedence). nvm was removed — it loaded synchronously on
# every startup and its node was already shadowed. mise installs runtimes per-user,
# which also suits the non-admin neo account (no brew/admin needed there).

# Paths
# Local binaries
export PATH="$PATH:/usr/local/bin:$HOME/.local/bin:$HOME/.bin"

# Node.js
export PATH="$PATH:./node_modules/.bin"

# Go
if (( $+commands[go] )); then
    export GOPATH=$HOME/go
    export GOROOT="$(brew --prefix golang)/libexec"
    export PATH=$PATH:$GOPATH/bin:$GOROOT/bin
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Shell integrations (load only if commands exist)
if (( $+commands[fzf] )); then
    eval "$(fzf --zsh)"
fi

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi

if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi

if (( $+commands[direnv] )); then
    eval "$(direnv hook zsh)"
fi

# atuin — SQLite-backed, searchable shell history on Ctrl+R. Loaded after fzf so
# atuin owns Ctrl+R; --disable-up-arrow leaves the custom up/down history-search
# bindings above untouched. History DB is per-account (neo's stays separate).
if (( $+commands[atuin] )); then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# Load any local overrides
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Performance profiling (uncomment with first line to debug slow startup)
# zprof

# Added by Antigravity
export PATH="/Users/adrian/.antigravity/antigravity/bin:$PATH"

# Sourced only if present — this file is created by the uv/rust installer and
# won't exist on every account (e.g. neo), so guard it to avoid a startup error.
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/adrian/.lmstudio/bin"
# End of LM Studio CLI section

# bun completions
[ -s "/Users/adrian/.bun/_bun" ] && source "/Users/adrian/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# mise — activate LAST so its runtime shims sit ahead of every PATH entry above
# (including the Hermes node symlink in ~/.local/bin). Guarded so accounts without
# mise just skip it. Run `mise use -g node@lts` once per account to pick a runtime.
if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi
